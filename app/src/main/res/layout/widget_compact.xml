<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="GYMGRID"
            android:textColor="#43CC75"
            android:textSize="10sp" />
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="READY"
            android:textColor="#ECF7ED"
            android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_yes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_yes_button"
            android:contentDescription="@string/widget_yes_description"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="YES"
            android:textColor="#0B2516"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_no"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_no_button"
            android:contentDescription="@string/widget_no_description"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="NO"
            android:textColor="#0B2516"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
